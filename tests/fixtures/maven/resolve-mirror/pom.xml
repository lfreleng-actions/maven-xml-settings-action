<!--
Resolves its dependency from xml-settings-upstream, which the generated
settings mirror by id. The declared URL is never seeded, so the
dependency resolves only if the mirror, and its credentials, applied.
An explicit id is mirrored rather than external:*, which excludes
localhost.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.lfreleng.xmlsettings</groupId>
  <artifactId>resolve-mirror</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <repositories>
    <repository>
      <id>xml-settings-upstream</id>
      <url>${repo.url}/upstream</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.lfreleng.xmlsettings</groupId>
      <artifactId>dependency</artifactId>
      <version>1.0</version>
      <type>pom</type>
    </dependency>
  </dependencies>
</project>
